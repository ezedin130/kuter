# ==============================================================================
# Kuter - Multi-Tenant Building Materials Inventory Management SaaS
# Environment Variables Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
# Never commit .env or real credentials to source control.
# ==============================================================================

# Spring Profile & Application Configuration
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
SERVER_ADDRESS=0.0.0.0

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kuter_dev
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password

# Database Connection Pool Settings (HikariCP)
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# CORS Allowed Origins (Comma-separated URLs for frontend applications)
# Admin Portal (Port 5174) & Public / Shop Frontend (Port 5173)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# JWT Authentication (Used in upcoming security phases)
# Generate a cryptographically secure 256-bit+ key for production: openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# React Frontend Environment Variables
VITE_API_BASE_URL=http://localhost:8080/api/v1
